# Optional standard PostgreSQL connection. When absent, .local/postgres stores local synthetic data.
# Never commit real credentials. The app reads environment variables, not this example file.
# DATABASE_URL=postgresql://rental_app:YOUR_PASSWORD@127.0.0.1:5544/rental_trust
PORT=5199
NEXT_TELEMETRY_DISABLED=1

# Google Maps stays disabled unless the owner approves billing and supplies both restricted keys.
# The browser key is visible in the browser: restrict it to this site's HTTP referrer and only
# Maps JavaScript API + Places API (New). Never use it as a server secret.
# GOOGLE_MAPS_BROWSER_KEY=
# The server key is private: restrict it to Places API (New) and the server's outbound IP where possible.
# GOOGLE_PLACES_SERVER_KEY=
# Set only after explicit owner approval for Maps usage and billing.
# GOOGLE_MAPS_APPROVED=1
